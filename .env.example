# Copy this to .env and fill in your values
# Never commit .env to git!

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Command prefix for legacy prefix commands (default: !)
PREFIX=!

# Anthropic API key for @mention AI responses (pookie_ai cog)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Music playback. FFMPEG_PATH can be left blank when imageio-ffmpeg is installed.
FFMPEG_PATH=
MUSIC_DEFAULT_VOLUME=50
MUSIC_MAX_PLAYLIST=100
MUSIC_IDLE_TIMEOUT=180

# Optional Netscape-format cookies for sites that require login. Keep this file private.
YTDLP_COOKIE_FILE=
